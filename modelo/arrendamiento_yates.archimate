    </element>
  </folder>
  <folder name="Application" id="id-5fa97bfbd29940d7b76fdf18dde5b82a" type="application">
    <element xsi:type="archimate:ApplicationFunction" name="Gestión del arriendo" id="id-16f74957484a47e080374754c6ff4135">
      <documentation>Controla el ciclo general del arriendo: disponibilidad, solicitud, reserva, estados y cancelaciones.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Arriendo" id="id-cacdaf92e3c2487d8ab97101376d7ee5">
      <documentation>Información que identifica y mantiene el ciclo general de un arriendo.</documentation>
      <property key="Tipo DDD" value="Raíz de agregado"/>
      <property key="Invariante" value="Solo se confirma con elegibilidad aprobada y, cuando el acuerdo lo exija, autorización del propietario. Una reserva confirmada no autoriza la entrega."/>
    </element>
    <element xsi:type="archimate:DataObject" name="Reserva" id="id-ce6958e1f2ab4e7ea18a5b1b01f63daa">
      <documentation>Información de la solicitud y confirmación de uso de un yate en un periodo.</documentation>
      <property key="Tipo DDD" value="Entidad"/>
    </element>
    <element xsi:type="archimate:DataObject" name="Disponibilidad del yate" id="id-26040ce9c0f94c378700942bc84ae939">
      <documentation>Información sobre periodos, bloqueos y posibilidad de comprometer un yate.</documentation>
      <property key="Tipo DDD" value="Raíz de agregado"/>
      <property key="Invariante" value="Dos periodos confirmados sobre el mismo yate no pueden solaparse. Un bloqueo impide confirmar; liberar un compromiso exige gestionar el incumplimiento."/>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Operación y seguimiento del yate" id="id-63f803f1647e4c3d9919c9a0333c53f5">
      <documentation>Controla preparación, entrega, seguimiento durante el uso, recepción e inspección del yate.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Inspección del yate" id="id-7ae85d4387244a728a5e430392330786">
      <documentation>Información resultante de las revisiones antes de entrega y después de devolución.</documentation>
      <property key="Tipo DDD" value="Entidad"/>
    </element>
    <element xsi:type="archimate:DataObject" name="Lectura operativa" id="id-bd26c4ae38b3445b85344f84c46f8ec9">
      <documentation>Información de ubicación, combustible y momento de medición durante el arriendo.</documentation>
      <property key="Tipo DDD" value="Entidad"/>
    </element>
    <element xsi:type="archimate:DataObject" name="Incidente" id="id-d250af364fda4892997f5175468dc211">
      <documentation>Información de una situación anormal registrada durante la operación.</documentation>
      <property key="Tipo DDD" value="Entidad"/>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Evaluación de riesgo" id="id-08c99edc4bbe46c9a74598601fd5c811">
      <documentation>Determina si un arriendo puede continuar y bajo qué condiciones desde la perspectiva de riesgo.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Evaluación de riesgo" id="id-95185947936f48139e74d1473a639362">
      <documentation>Información de la evaluación realizada sobre cliente y condiciones del arriendo.</documentation>
      <property key="Tipo DDD" value="Raíz de agregado"/>
      <property key="Invariante" value="Ningún resultado es apto si falta un requisito obligatorio. La recomendación externa informa, pero no decide por sí sola."/>
    </element>
    <element xsi:type="archimate:DataObject" name="Requisito del cliente" id="id-42956fdf5f9b4885ba1e1bc551cf7504">
      <documentation>Información de las condiciones que el cliente debe cumplir para continuar.</documentation>
      <property key="Tipo DDD" value="Entidad"/>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Liquidación" id="id-29f1a448a76348edb62d8497f9c9223c">
      <documentation>Determina obligaciones económicas, ajustes y cierre económico del arriendo.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Garantía" id="id-f388d78a240547dcb72acc7ed81ec7aa">
      <documentation>Información de depósito o garantía asociada al arriendo.</documentation>
      <property key="Tipo DDD" value="Raíz de agregado"/>
      <property key="Invariante" value="La garantía no es ingreso: solo se retiene lo sustentado y el saldo se libera o se reembolsa."/>
    </element>
    <element xsi:type="archimate:DataObject" name="Ajuste económico" id="id-f98db1a961d44917a05c5336068cc166">
      <documentation>Información de modificaciones económicas posteriores al uso.</documentation>
      <property key="Tipo DDD" value="Objeto de valor"/>
    </element>
    <element xsi:type="archimate:DataObject" name="Reclamación de cobro" id="id-2db9c41d2746491d8856dbc5ac2b1326">
      <documentation>Información de una objeción frente a un cargo del arriendo.</documentation>
      <property key="Tipo DDD" value="Raíz de agregado"/>
      <property key="Invariante" value="Se resuelve con evidencia y antes del cierre económico; no se cierra el arriendo con reclamaciones abiertas."/>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Reputación" id="id-4c8f87372e9c4fb39d4e04471d59fa98">
      <documentation>Gestiona valoraciones e historial de reputación de clientes y propietarios.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Calificación" id="id-d1dc9e548b4d4fdda0a6710f3caede07">
      <documentation>Información de la valoración emitida tras una experiencia de arriendo.</documentation>
      <property key="Tipo DDD" value="Entidad"/>
    </element>
    <element xsi:type="archimate:DataObject" name="Historial de reputación" id="id-258da4d378224caebf0269f6def39957">
      <documentation>Información acumulada de valoraciones previas de un participante.</documentation>
      <property key="Tipo DDD" value="Objeto de valor"/>
    </element>
