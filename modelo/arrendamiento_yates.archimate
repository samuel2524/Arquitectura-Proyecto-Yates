    <element xsi:type="archimate:ApplicationComponent" name="Capa anticorrupción del arrendamiento" id="id-f5-acl-017">
      <documentation>Capa anticorrupción (ACL). Traduce entre el modelo de cada sistema externo y el modelo de los contextos del arriendo, de modo que un cambio en un tercero no arrastre los dominios. Es la cara de aplicación de la capa anticorrupción de la fase 2.</documentation>
      <property key="Patrón" value="Capa anticorrupción"/>
      <property key="Rol" value="Traducción e interoperabilidad"/>
    </element>
