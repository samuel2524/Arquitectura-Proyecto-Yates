      <property key="Dominio" value="Reputación"/>
      <property key="Clasificación" value="Supporting"/>
      <property key="Ejemplo" value="Se consultan las valoraciones previas antes de un nuevo arriendo."/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Valoración cuestionada" id="term36">
      <documentation>Término del lenguaje ubicuo del dominio Reputación.</documentation>
      <property key="Dominio" value="Reputación"/>
      <property key="Clasificación" value="Supporting"/>
      <property key="Ejemplo" value="El cliente afirma que una valoración contiene información incorrecta."/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Participante evaluado" id="term37">
