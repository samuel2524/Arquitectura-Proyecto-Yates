  <folder name="Motivation" id="id-9702c1e18db64882b49e263b5b465236" type="motivation">
    <element xsi:type="archimate:Stakeholder" name="Dirección general" id="id-SH1">
      <documentation>Fuente: P19</documentation>
    </element>
