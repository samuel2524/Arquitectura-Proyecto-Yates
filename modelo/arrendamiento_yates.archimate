      <property key="Tipo DDD" value="Contexto delimitado"/>
      <property key="Clasificación" value="Core"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Servicio de reserva del arriendo" id="id-f5-bs-002">
