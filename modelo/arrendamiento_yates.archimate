      <documentation>Fuente: P1, P4</documentation>
    </element>
    <element xsi:type="archimate:Stakeholder" name="Marina" id="id-SH4">
      <documentation>Fuente: P4, P25</documentation>
    </element>
    <element xsi:type="archimate:Stakeholder" name="Responsable de operaciones" id="id-SH5">
      <documentation>Fuente: P4</documentation>
    </element>
    <element xsi:type="archimate:Driver" name="Ingresos por comisión y aprovechamiento de la flota" id="id-D1">
      <documentation>Fuente: P2, P19</documentation>
    </element>
    <element xsi:type="archimate:Driver" name="Cuidado y control de su yate" id="id-D2">
      <documentation>Fuente: P1, P6</documentation>
    </element>
    <element xsi:type="archimate:Driver" name="Recibir el servicio acordado de forma segura" id="id-D3">
      <documentation>Fuente: P1, P3</documentation>
    </element>
    <element xsi:type="archimate:Driver" name="Coordinación de la preparación, entrega y recepción" id="id-D4">
      <documentation>Fuente: P11, P25</documentation>
    </element>
    <element xsi:type="archimate:Driver" name="Seguridad al entregar bienes de terceros" id="id-D5">
      <documentation>Fuente: P3, P4</documentation>
    </element>
    <element xsi:type="archimate:Goal" name="Aprovechar la flota y cumplir las reservas comprometidas" id="id-G1">
      <documentation>Fuente: P3, P19</documentation>
    </element>
    <element xsi:type="archimate:Goal" name="Entregar bienes de terceros de forma segura" id="id-G2">
      <documentation>Fuente: P3, P4, solicitud</documentation>
    </element>
    <element xsi:type="archimate:Goal" name="Coordinar sin fricción la entrega y la devolución" id="id-G3">
      <documentation>Fuente: P5, P25</documentation>
    </element>
    <element xsi:type="archimate:Goal" name="Cerrar cada arriendo con responsabilidades y pagos resueltos" id="id-G4">
      <documentation>Fuente: P3, P14</documentation>
    </element>
    <element xsi:type="archimate:Assessment" name="Una solicitud no garantiza la reserva y un mismo yate puede recibir solicitudes con fechas cruzadas" id="id-A1">
      <documentation>Fuente: P7, P8</documentation>
    </element>
    <element xsi:type="archimate:Assessment" name="El propietario puede bloquear o usar el yate después de una reserva confirmada" id="id-A2">
      <documentation>Fuente: P3, P9</documentation>
    </element>
    <element xsi:type="archimate:Assessment" name="El cliente puede no tener la experiencia o la habilitación para manejar el yate" id="id-A3">
      <documentation>Fuente: P3, P10</documentation>
    </element>
    <element xsi:type="archimate:Assessment" name="Un yate con reserva confirmada puede no estar en condiciones de salir por falla, documentación o restricción" id="id-A4">
      <documentation>Fuente: P8, P9, P11</documentation>
    </element>
    <element xsi:type="archimate:Assessment" name="No todas las marinas prestan inspección, preparación o abastecimiento; depende de los acuerdos" id="id-A5">
      <documentation>Fuente: P11, P25</documentation>
    </element>
    <element xsi:type="archimate:Assessment" name="No todos los yates transmiten ubicación y combustible, y las lecturas pueden faltar, llegar tarde o ser aproximadas" id="id-A6">
      <documentation>Fuente: P12, P27</documentation>
    </element>
    <element xsi:type="archimate:Assessment" name="Encontrar un daño al devolver el yate no prueba por sí solo que el cliente sea responsable" id="id-A7">
      <documentation>Fuente: P13, P16</documentation>
    </element>
    <element xsi:type="archimate:Assessment" name="El cliente puede no completar el pago o discutir el depósito, y recibir el yate no cierra las cuentas" id="id-A8">
      <documentation>Fuente: P3, P14, P15</documentation>
    </element>
    <element xsi:type="archimate:Outcome" name="Tasa de ocupación del tiempo habilitado en el nivel que fije la dirección" id="id-O1">
      <documentation>Fuente: P19</documentation>
    </element>
    <element xsi:type="archimate:Outcome" name="Ningún yate con dos reservas confirmadas para períodos incompatibles" id="id-O2">
      <documentation>Fuente: P7</documentation>
    </element>
    <element xsi:type="archimate:Outcome" name="Menos cancelaciones por indisponibilidad del propietario o de la marina" id="id-O3">
      <documentation>Fuente: P9, P19</documentation>
    </element>
    <element xsi:type="archimate:Outcome" name="Ninguna entrega sin requisitos del cliente, pagos, depósito, seguro vigente e inspección" id="id-O4">
      <documentation>Fuente: P3, P8, P15, P24</documentation>
    </element>
    <element xsi:type="archimate:Outcome" name="Yates entregados a la hora acordada" id="id-O5">
      <documentation>Fuente: P19</documentation>
    </element>
    <element xsi:type="archimate:Outcome" name="Toda entrega y devolución con acta y evidencia del estado y el combustible" id="id-O6">
      <documentation>Fuente: P11, P13</documentation>
    </element>
    <element xsi:type="archimate:Outcome" name="Menor tiempo entre la recepción del yate y el cierre económico" id="id-O7">
      <documentation>Fuente: P14, P19</documentation>
    </element>
    <element xsi:type="archimate:Outcome" name="Reclamaciones resueltas con una decisión fundamentada" id="id-O8">
      <documentation>Fuente: P17, P19</documentation>
    </element>
    <element xsi:type="archimate:Outcome" name="Clientes y propietarios satisfechos con su experiencia" id="id-O9">
      <documentation>Fuente: P3, P19</documentation>
    </element>
    <element xsi:type="archimate:Principle" name="El propietario decide la disponibilidad, pero no retira una fecha comprometida sin gestionar el incumplimiento" id="id-P1">
      <documentation>Fuente: P6, P9</documentation>
    </element>
    <element xsi:type="archimate:Principle" name="Una reserva confirmada no equivale a una entrega autorizada" id="id-P2">
      <documentation>Fuente: P8, P10</documentation>
    </element>
    <element xsi:type="archimate:Principle" name="La seguridad de las personas prima sobre rutas, cobros y depósitos" id="id-P3">
      <documentation>Fuente: P12, P17</documentation>
    </element>
    <element xsi:type="archimate:Principle" name="Todo cobro se sustenta en evidencia comparada, no en una lectura remota ni en la sola existencia del daño" id="id-P4">
      <documentation>Fuente: P12, P16, P26</documentation>
    </element>
    <element xsi:type="archimate:Principle" name="El uso termina con la devolución; el arriendo, con el cierre económico" id="id-P5">
      <documentation>Fuente: P5, P14</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="Consultar yates disponibles en la marina más cercana" id="id-RQ1">
      <documentation>Fuente: Alcance</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="Habilitar o bloquear el yate y suspenderlo por falla o documentación" id="id-RQ2">
      <documentation>Fuente: Alcance, P6</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="Controlar el calendario de cada yate, con apartado temporal y tiempo de preparación" id="id-RQ3">
      <documentation>Fuente: P7</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="Notificar la reserva y sus cambios al propietario y a la marina" id="id-RQ4">
      <documentation>Fuente: Alcance, P25</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="Verificar requisitos del cliente y pedir evaluación externa de riesgo cuando aplique" id="id-RQ5">
      <documentation>Fuente: P10, P23</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="Cobrar alquiler, seguro y constituir el depósito antes de la entrega" id="id-RQ6">
      <documentation>Fuente: Alcance, P15, P26</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="Registrar actas de entrega y devolución con fotografías y combustible" id="id-RQ7">
      <documentation>Fuente: P11, P13</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="Mostrar ubicación y combustible con la hora de la medición y alertar si faltan lecturas" id="id-RQ8">
      <documentation>Fuente: Alcance, P12, P27</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="Liquidar combustible, daños sustentados y depósito, con trámite de reclamación" id="id-RQ9">
      <documentation>Fuente: Alcance, P15-P17</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="Calificar mutuamente tras la devolución y revisar valoraciones cuestionadas" id="id-RQ10">
      <documentation>Fuente: Alcance, P18</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="Gestionar cancelaciones e incumplimientos con alternativas y registro de la causa" id="id-RQ11">
      <documentation>Fuente: P9</documentation>
    </element>
    <element xsi:type="archimate:Constraint" name="Requisitos de la autoridad marítima de la jurisdicción: matrícula, zarpe y licencias" id="id-C1">
      <documentation>Fuente: P20 (por contrastar)</documentation>
    </element>
    <element xsi:type="archimate:Constraint" name="Norma de protección de datos aplicable, incluida la ubicación" id="id-C2">
      <documentation>Fuente: P12, P20, P23 (por contrastar)</documentation>
    </element>
    <element xsi:type="archimate:Constraint" name="Condiciones pactadas en los contratos con propietarios y clientes" id="id-C3">
      <documentation>Fuente: P22 (por contrastar)</documentation>
    </element>
    <element xsi:type="archimate:Constraint" name="Coberturas y exclusiones de las pólizas para uso comercial" id="id-C4">
      <documentation>Fuente: P24 (por contrastar)</documentation>
    </element>
    <element xsi:type="archimate:Constraint" name="Lo que permita el medio de pago para retener o cobrar el depósito" id="id-C5">
      <documentation>Fuente: P15, P26 (por contrastar)</documentation>
    </element>
