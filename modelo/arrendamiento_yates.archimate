    <element xsi:type="archimate:Meaning" name="Conjunto de calificaciones y antecedentes relacionados con experiencias anteriores." id="meaning35">
      <documentation>Conjunto de calificaciones y antecedentes relacionados con experiencias anteriores.</documentation>
      <property key="Dominio" value="Reputación"/>
      <property key="Término" value="Historial de reputación"/>
    </element>
    <element xsi:type="archimate:Meaning" name="Calificación cuya validez o contenido es objeto de una reclamación." id="meaning36">
      <documentation>Calificación cuya validez o contenido es objeto de una reclamación.</documentation>
      <property key="Dominio" value="Reputación"/>
      <property key="Término" value="Valoración cuestionada"/>
    </element>
    <element xsi:type="archimate:Meaning" name="Persona sobre la cual se registra una calificación." id="meaning37">
      <documentation>Persona sobre la cual se registra una calificación.</documentation>
      <property key="Dominio" value="Reputación"/>
      <property key="Término" value="Participante evaluado"/>
    </element>
    <element xsi:type="archimate:Meaning" name="Devolución física ≠ Reembolso" id="id-69e55654722246ceb44c18f1740ce00b">
      <documentation>Devolución física significa que el yate regresó y fue recibido; reembolso significa devolver dinero al cliente.</documentation>
    </element>
    <element xsi:type="archimate:Meaning" name="Resultado de riesgo ≠ Autorización de entrega" id="id-98d7873eca2c4169b1c9a205ef8fb95a">
      <documentation>El resultado de riesgo indica si el arriendo puede continuar y bajo qué condiciones; la autorización de entrega confirma que el yate puede salir físicamente en ese momento.</documentation>
    </element>
    <element xsi:type="archimate:Meaning" name="Estado del arriendo ≠ Estado del yate" id="id-a7adf06f07904a0cb50e1fc248b4f5f2">
      <documentation>El estado del arriendo describe el ciclo administrativo; el estado del yate describe la condición física u operativa de la embarcación.</documentation>
    </element>
    <element xsi:type="archimate:Meaning" name="Daño observado ≠ Cargo por daño" id="id-8f6d5a3ceed84c118682f7e5fd68bd85">
      <documentation>Operación registra una novedad o daño observado; Liquidación determina si existe un cargo económico sustentado.</documentation>
    </element>
  </folder>
  <folder name="Implementation &amp; Migration" id="id-f772fe18fe074c448bfd202e7d686af2" type="implementation_migration"/>
  <folder name="Other" id="id-7ff9ed6eeac049e68b44f94f5a947e43" type="other">
    <element xsi:type="archimate:Grouping" name="Capacidades estratégicas" id="id-GR1"/>
    <element xsi:type="archimate:Grouping" name="Capacidades misionales" id="id-GR2"/>
    <element xsi:type="archimate:Grouping" name="Capacidades de apoyo" id="id-GR3"/>
    <element xsi:type="archimate:Grouping" name="Capa 1 · Servicio de proceso" id="id-GL1">
      <documentation>Un solo servicio que representa el E2E completo del arriendo. Es lo que «compra» el negocio.</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="Capa 2 · Servicios de etapa (orquestación)" id="id-GL2">
      <documentation>Un servicio por etapa de la cadena de valor que toca la aplicación (VS3–VS6). Orquestan servicios de tarea; no tienen lógica propia.</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="Capa 3 · Servicios de tarea (negocio)" id="id-GL3">
      <documentation>Servicios del tamaño adecuado: cada uno cubre uno o pocos pasos del E2E, tiene un rol responsable y es dueño de su información. Sobre estos se construye la aplicación.</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="Capa 4 · Servicios de entidad" id="id-GL4">
      <documentation>Administran la información maestra que comparten varias tareas (yates, clientes, propietarios, marinas, expediente). Agnósticos del proceso, muy reutilizables.</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="Capa 5 · Servicios utilitarios" id="id-GL5">
      <documentation>Capacidades transversales sin lógica del negocio de yates: notificar, guardar evidencias, identidad, cercanía, auditoría.</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="Capa 6 · Anticorrupción (interoperabilidad)" id="id-GL6">
      <documentation>Un adaptador por cada participante externo. Traduce el modelo del otro al nuestro para que un cambio de proveedor no contamine el núcleo.</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="Servicios excluidos" id="id-GLX">
      <documentation>Identificados pero no se implementan; ver tabla de inclusión y exclusión.</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="DOMINIOS SUPPORTING" id="id-cba065da859f485eb49feb5d74433788"/>
    <element xsi:type="archimate:Grouping" name="Núcleo compartido: Arriendo, Yate y Participante" id="id-f5-grp-016">
      <documentation>Núcleo compartido por Gestión del arriendo y Operación y seguimiento. Los identificadores de Arriendo, Yate y Participante y el calendario de compromisos se interpretan igual en los dos contextos, sin traducción.</documentation>
      <property key="Patrón" value="Núcleo compartido"/>
    </element>
    <element xsi:type="archimate:Grouping" name="Cliente-proveedor" id="id-f5-leg-111">
      <documentation>Patrón de relación señalado en el mapa de contextos delimitados.</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="Conformista" id="id-f5-leg-113">
      <documentation>Patrón de relación señalado en el mapa de contextos delimitados.</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="Núcleo compartido" id="id-f5-leg-115">
      <documentation>Patrón de relación señalado en el mapa de contextos delimitados.</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="Servicio abierto" id="id-f5-leg-117">
      <documentation>Patrón de relación señalado en el mapa de contextos delimitados.</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="Lenguaje publicado" id="id-f5-leg-119">
      <documentation>Patrón de relación señalado en el mapa de contextos delimitados.</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="Capa anticorrupción (ACL)" id="id-f5-leg-121">
      <documentation>Patrón de relación señalado en el mapa de contextos delimitados.</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="Grouping" id="id-b48e048acbd54c3b8a2caaa3aac57b21"/>
  </folder>
