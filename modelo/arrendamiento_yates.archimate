    <element xsi:type="archimate:ApplicationInterface" name="Interfaz de reserva del arriendo" id="id-f5-bi-003">
      <documentation>Interfaz de aplicación del contexto de gestión del arriendo. Expone su servicio publicado y oculta el modelo interno.</documentation>
      <property key="Rol" value="Interfaz del contexto"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Contexto de Evaluación de riesgo" id="id-f5-bc-004">
      <documentation>Contexto delimitado que juzga si un arriendo puede continuar y bajo qué condiciones. Provee la elegibilidad al contexto de Gestión del arriendo.</documentation>
      <property key="Tipo DDD" value="Contexto delimitado"/>
      <property key="Clasificación" value="Supporting"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Servicio de evaluación de riesgo" id="id-f5-bs-005">
