      <property key="Dominio" value="Reputación"/>
      <property key="Clasificación" value="Supporting"/>
      <property key="Ejemplo" value="Cliente o propietario evaluado después de un arriendo."/>
    </element>
    <element xsi:type="archimate:BusinessEvent" name="Reserva confirmada" id="id-f4-ev-034">
      <documentation>Evento de negocio que marca un hito del arriendo.</documentation>
      <property key="Tipo" value="Evento de negocio"/>
    </element>
    <element xsi:type="archimate:BusinessEvent" name="Elegibilidad aprobada" id="id-f4-ev-147">
      <documentation>Evento de negocio que marca un hito del arriendo.</documentation>
