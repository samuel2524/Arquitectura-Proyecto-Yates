    <element xsi:type="archimate:FlowRelationship" name="cliente-proveedor" id="id-f5-rel-044" source="id-f5-bc-004" target="id-f5-bc-001">
      <documentation>Evaluación de riesgo es el proveedor (upstream) y Gestión del arriendo el cliente (downstream): el resultado de la evaluación alimenta la decisión de reserva.</documentation>
      <property key="Patrón" value="Cliente-proveedor"/>
    </element>
    <element xsi:type="archimate:FlowRelationship" name="cliente-proveedor" id="id-f5-rel-045" source="id-f5-bc-001" target="id-f5-bc-007">
      <documentation>Gestión del arriendo es el proveedor y Operación el cliente: la reserva confirmada es la entrada de la operación.</documentation>
      <property key="Patrón" value="Cliente-proveedor"/>
    </element>
    <element xsi:type="archimate:FlowRelationship" name="cliente-proveedor" id="id-f5-rel-046" source="id-f5-bc-007" target="id-f5-bc-010">
      <documentation>Operación es el proveedor y Liquidación el cliente: las actas y novedades sustentan los ajustes económicos.</documentation>
      <property key="Patrón" value="Cliente-proveedor"/>
    </element>
    <element xsi:type="archimate:ServingRelationship" name="servicio abierto" id="id-f5-rel-047" source="id-f5-bs-002" target="id-f5-bc-013">
      <documentation>Gestión del arriendo expone un servicio abierto con el lenguaje publicado del arriendo; Reputación lo consume de forma conformista, adoptando sus identificadores sin traducirlos.</documentation>
      <property key="Patrón" value="Servicio abierto + lenguaje publicado"/>
    </element>
    <element xsi:type="archimate:AssociationRelationship" name="núcleo" id="id-f5-rel-048" source="id-f5-grp-016" target="id-f5-bc-001">
