      <property key="Rol" value="Interfaz del contexto"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Contexto de Operación y seguimiento del yate" id="id-f5-bc-007">
      <documentation>Contexto delimitado que controla el estado físico del yate entre la entrega y la recepción, y las lecturas del uso. Provee la evidencia a Liquidación.</documentation>
